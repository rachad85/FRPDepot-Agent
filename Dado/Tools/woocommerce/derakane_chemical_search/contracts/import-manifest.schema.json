{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frpdepots.local/contracts/derakane-search/import-manifest-v2.schema.json",
  "title": "FRP Depot Derakane search import manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "generated_utc", "producer", "verification", "source", "rebuild_provenance", "dataset", "summary"],
  "properties": {
    "contract": {"const": "frpdepot.derakane-search.import-manifest"},
    "contract_version": {"const": 2},
    "generated_utc": {"type": "string", "format": "date-time"},
    "permission_documented": {"type": "boolean"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["pipeline", "contract_version", "run_id"],
      "properties": {
        "pipeline": {"const": "frpdepot.derakane-guide-rebuild"},
        "contract_version": {"const": 2},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "unresolved_count", "reviewed_row_count", "method", "verified_utc", "verifier"],
      "properties": {
        "status": {"enum": ["VERIFIED", "NOT_VERIFIED"]},
        "unresolved_count": {"type": "integer", "minimum": 0},
        "reviewed_row_count": {"type": "integer", "minimum": 0},
        "method": {"type": "string", "minLength": 1},
        "verified_utc": {"type": ["string", "null"], "format": "date-time"},
        "verifier": {"type": ["string", "null"]}
      }
    },
    "source": {"$ref": "https://frpdepots.local/contracts/derakane-search/dataset-v2.schema.json#/$defs/source"},
    "rebuild_provenance": {"$ref": "https://frpdepots.local/contracts/derakane-search/dataset-v2.schema.json#/$defs/rebuildProvenance"},
    "dataset": {
      "type": "object", "additionalProperties": false, "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": {"const": "derakane-dataset.json"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "https://frpdepots.local/contracts/derakane-search/dataset-v2.schema.json#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["row_count", "chemical_count", "search_entity_count", "footnote_count", "resin_columns", "rating_count", "source_special_count", "parser_uncertainty_count", "cas_entry_count", "cas_public_searchable_count", "cas_excluded_count"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 1},
        "chemical_count": {"type": "integer", "minimum": 1},
        "search_entity_count": {"type": "integer", "minimum": 1},
        "footnote_count": {"const": 25},
        "resin_columns": {"$ref": "https://frpdepots.local/contracts/derakane-search/dataset-v2.schema.json#/$defs/resinIds"},
        "rating_count": {"type": "integer", "minimum": 1},
        "source_special_count": {"type": "integer", "minimum": 0},
        "parser_uncertainty_count": {"const": 0},
        "cas_entry_count": {"type": "integer", "minimum": 1},
        "cas_public_searchable_count": {"type": "integer", "minimum": 0},
        "cas_excluded_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
